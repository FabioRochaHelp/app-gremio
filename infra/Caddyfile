# Atrás do proxy reverso do servidor, que faz o HTTPS: aqui só HTTP na porta 3000.
# DOMINIO vem do .env de produção.
{
	auto_https off
	servers {
		# Mantém o IP do cliente que o proxy do servidor repassa em X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

:3000 {
	encode zstd gzip

	# Comprovantes e PDFs: o navegador abre links assinados direto no armazenamento.
	# O Host original é repassado para a assinatura conferir.
	@arquivos host arquivos.{$DOMINIO}
	handle @arquivos {
		reverse_proxy s3:9000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		# O service worker precisa ser revalidado sempre, senão o app não atualiza.
		header /sw.js Cache-Control "no-cache"
		header /_nuxt/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
