# Copie para infra/.env.prod e preencha. Nunca versione o .env.prod.

# Domínio do app (o DNS de DOMINIO e de arquivos.DOMINIO deve apontar para a VPS).
DOMINIO=gremio.exemplo.com.br
WEB_ORIGIN=https://gremio.exemplo.com.br

POSTGRES_USER=gremio
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=gremio

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# As mesmas chaves do s3.prod.json.
S3_REGION=us-east-1
S3_BUCKET=gremio
S3_ACCESS_KEY=gremio
S3_SECRET_KEY=troque-pela-chave-do-s3.prod.json

# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tesouraria@exemplo.com.br

# Tesoureiro inicial (usado só pelo seed; troque a senha no primeiro acesso).
SEED_TESOUREIRO_RE=000000
SEED_TESOUREIRO_NOME=Tesoureiro
SEED_TESOUREIRO_SENHA=troque-esta-senha
