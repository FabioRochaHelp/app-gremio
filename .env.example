# Copie para apps/api/.env e ajuste.
DATABASE_URL=postgresql://gremio:gremio@localhost:5432/gremio?schema=public
REDIS_URL=redis://localhost:6379
# Em produção a API usa false e o worker (dist/worker.js) processa as filas.
PROCESSAR_FILAS=true

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-access
JWT_REFRESH_SECRET=troque-este-segredo-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gremio
S3_ACCESS_KEY=gremio
S3_SECRET_KEY=gremio-s3-secret
# Endereço do S3 visto pelo navegador, para os links de comprovantes (se diferente do S3_ENDPOINT).
S3_ENDPOINT_PUBLICO=

# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tesouraria@example.com

# Tesoureiro criado pelo seed (troque a senha no primeiro acesso)
SEED_TESOUREIRO_RE=000000
SEED_TESOUREIRO_NOME=Tesoureiro
SEED_TESOUREIRO_SENHA=trocar123
